# Copy to .env and fill in. The app runs without these (demo mode):
# reports are then kept in this browser only, and routing uses public OSRM.

# Supabase project settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# openrouteservice.org -> dashboard -> API key (enables true avoid-zone routing)
VITE_ORS_KEY=

# Grok (xAI) spoken route summary. The key itself is NOT set here: add XAI_API_KEY
# as a Supabase Edge Function secret and deploy supabase/functions/guide. Then:
VITE_GROK_GUIDE=
